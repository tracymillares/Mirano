{% extends 'base.html.twig' %}

{% block title %}Change Password{% endblock %}

{% block body %}

{% include 'layouts/sidebar.html.twig' %} 

<style>
    body {
        font-family: 'Poppins', sans-serif;
        background-color: #fff8f5;
    }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.4);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .modal {
        background: #fff;
        padding: 2rem;
        border-radius: 16px;
        width: 90%;
        max-width: 400px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        text-align: center;
        position: relative;
    }

    .modal h1 {
        color: #b23a48;
        margin-bottom: 1rem;
        font-size: 1.4rem;
        font-weight: 700;
    }

    .form-control {
        width: 100%;
        padding: 0.6rem 0.8rem;
        margin-bottom: 1rem;
        border-radius: 8px;
        border: 1px solid #ccc;
        font-size: 0.95rem;
    }

    .btn {
        background-color: #b23a48;
        color: #fff8f5;
        border: none;
        padding: 0.8rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        width: 100%;
        transition: 0.2s;
        margin-top: 0.5rem;
    }

    .btn:hover {
        background-color: #7e3b1b;
        transform: translateY(-2px);
    }

    .alert {
        padding: 0.8rem;
        border-radius: 8px;
        margin-bottom: 1rem;
        font-size: 0.9rem;
        text-align: left;
    }

    .alert-success {
        background-color: #d4edda;
        color: #155724;
    }

    .alert-danger {
        background-color: #f8d7da;
        color: #721c24;

    }

    /* Back to profile button */
    .back-link {
        display: inline-block;
        margin-top: 1rem;
        padding: 0.6rem 1.2rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        color: #b23a48;
        border: 2px solid #b23a48;
        background-color: transparent;
        transition: all 0.25s ease;
    }

    .back-link:hover {
        background-color: #b23a48;
        color: #fff8f5;
        transform: translateY(-1px);
    }

    .back-link:focus {
        outline: none;
        box-shadow: 0 0 0 3px rgba(178, 58, 72, 0.3);
    }
    
</style>

<div class="modal-overlay">
    <div class="modal">

        <h1>Change Password</h1>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        {{ form_start(passwordForm) }}

            {{ form_row(passwordForm.plainPassword.first, {
                'attr': {'class': 'form-control'},
                'label': 'New Password'
            }) }}

            {{ form_row(passwordForm.plainPassword.second, {
                'attr': {'class': 'form-control'},
                'label': 'Confirm Password'
            }) }}

            <button type="submit" class="btn">Update Password</button>

        {{ form_end(passwordForm) }}

       <a href="{{ path('app_admin_profile') }}" class="back-link">← Back to Profile</a>

</div>
{% endblock %}
