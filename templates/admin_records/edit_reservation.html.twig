{% extends 'base.html.twig' %}

{% block title %}Edit Reservation{% endblock %}

{% block body %}

{% include 'layouts/sidebar.html.twig' %}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>


<style>
    body {
        font-family: 'Poppins', sans-serif;
        background-color: #fff8f5;
        color: #5D2913;
        padding: 2rem;
    }

    h1 {
        text-align: center;
        margin-bottom: 2rem;
        color: #b23a48;
    }

    form {
        max-width: 600px;
        margin: 0 auto;
        background: #fff;
        padding: 2rem;
        border-radius: 16px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.1);
    }

    .form-group {
        margin-bottom: 1.2rem;
    }

    label {
        display: block;
        font-weight: 600;
        margin-bottom: 0.4rem;
    }

    input, textarea, select {
        width: 100%;
        padding: 0.6rem 0.8rem;
        border: 1px solid #f1d2c0;
        border-radius: 8px;
        font-size: 0.95rem;
        font-family: 'Poppins', sans-serif;
        background-color: #fff;
    }

    select[multiple] {
        min-height: 120px;
    }

    textarea {
        min-height: 100px;
        resize: vertical;
    }

    .action-btn {
        padding: 0.7rem 1.4rem;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        font-weight: 600;
        margin-top: 1rem;
        background-color: #b23a48;
        color: #fff;
        transition: 0.2s;
    }

    .action-btn:hover {
        background-color: #8e2f3a;
    }

    .select2-container--default .select2-selection--multiple {
    border: 1px solid #f1d2c0;
    border-radius: 8px;
    padding: 4px;
    min-height: 42px;
}

.select2-container--default .select2-selection__choice {
    background-color: #b23a48;
    border: none;
    color: #fff;
    border-radius: 6px;
    padding: 4px 8px;
}

</style>

<h1>Edit Reservation</h1>

{{ form_start(form) }}

<div class="form-group">
    {{ form_label(form.name) }}
    {{ form_widget(form.name) }}
    {{ form_errors(form.name) }}
</div>

<div class="form-group">
    {{ form_label(form.email) }}
    {{ form_widget(form.email) }}
    {{ form_errors(form.email) }}
</div>

<div class="form-group">
    {{ form_label(form.phone) }}
    {{ form_widget(form.phone) }}
    {{ form_errors(form.phone) }}
</div>

<div class="form-group">
    {{ form_label(form.guest) }}
    {{ form_widget(form.guest) }}
    {{ form_errors(form.guest) }}
</div>

<div class="form-group">
    {{ form_label(form.menu, 'Menu Item') }}
    {{ form_widget(form.menu) }}
    {{ form_errors(form.menu) }}
</div>


<div class="form-group">
    {{ form_label(form.date) }}
    {{ form_widget(form.date) }}
    {{ form_errors(form.date) }}
</div>

<div class="form-group">
    {{ form_label(form.message) }}
    {{ form_widget(form.message) }}
    {{ form_errors(form.message) }}
</div>

<button type="submit" class="action-btn">Save</button>

{{ form_end(form) }}

<script>
    $(document).ready(function () {
        $('#{{ form.menu.vars.id }}').select2({
            placeholder: "Search and select menu items",
            width: '100%',
            allowClear: true
        });
    });
</script>

{% endblock %}
