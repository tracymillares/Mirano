<head>
    <meta charset="UTF-8">
    <title>{% block title %}Mirano Restaurant{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {# ✅ Use Symfony Encore to include compiled CSS #}
    {{ encore_entry_link_tags('app') }}

    {% block stylesheets %}{% endblock %}
</head>


  <body class="antialiased bg-gray-50 text-gray-900">

    <!-- Simple Navbar -->
    <nav class="bg-white shadow">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <div class="flex-shrink-0">
          <a href="{{ path('app_mirano') }}">
  <img src="{{ asset('images/Screenshot_2025-10-11_215348-removebg-preview.png') }}" alt="Mirano Logo" class="logo-img">
</a>

          </div>
          <div class="hidden md:flex space-x-6">
            <a href="{{ path('app_mirano') }}#about" class="text-gray-700 hover:text-rose-600">About</a>
            <a href="{{ path('app_mirano') }}#menu" class="text-gray-700 hover:text-rose-600">Menu</a>
            <a href="#contact" class="text-gray-700 hover:text-rose-600">Contact</a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Page Content -->
    <main>
      {% block body %}{% endblock %}
    </main>

    {% block javascripts %}{% endblock %}
            {{ encore_entry_script_tags('app') }}

            {# Modal Overlay - Hidden by default #}
<div id="auth-modal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-md p-6 relative">
        <button onclick="closeModal()" class="absolute top-3 right-3 text-gray-500 hover:text-gray-900">&times;</button>

        <div id="modal-content">
            {# Content will be injected: login or register #}
        </div>
    </div>
</div>

<script>
    function openModal(contentHtml) {
        const modal = document.getElementById('auth-modal');
        const contentDiv = document.getElementById('modal-content');
        contentDiv.innerHTML = contentHtml;
        modal.classList.remove('hidden');
    }

    function closeModal() {
        document.getElementById('auth-modal').classList.add('hidden');
    }
</script>

  </body>
  {{ encore_entry_script_tags('app') }}

</html>
