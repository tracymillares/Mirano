<form method="post" 
      action="{{ path('app_mirano_menu_delete', {'id': menu.id}) }}" 
      onsubmit="return confirm('Are you sure you want to delete this dish?');" 
      style="display:inline;">
  
  <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ menu.id) }}">

  <button class="mirano-btn-delete">
    🗑 Delete
  </button>
</form>

<style>
  .mirano-btn-delete {
    background-color: #b23a48;
    color: #fff;
    padding: 0.7rem 1.5rem;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    transition: all 0.3s ease;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  }

  .mirano-btn-delete:hover {
    background-color: #922b3e;
    transform: translateY(-2px);
  }
</style>
