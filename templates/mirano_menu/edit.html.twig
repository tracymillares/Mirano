{% extends 'base.html.twig' %}

{% block title %}Edit Menu | Mirano{% endblock %}

{% block body %}

  <style>
    body {
      background-color: #fff8f5;
      font-family: 'Poppins', sans-serif;
      color: #5D2913;
      margin: 0;
      padding: 0;
    }

    .header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 2rem;
    }

   .logo-img {
      width: 70px;
      height: auto;
      margin-right: 10px;
      padding: 10px;
      transition: transform 0.3s ease;
    }

    h1 {
      font-family: 'Merriweather', serif;
      text-align: left;
      font-size: 2rem;
      color: #5D2913;
    }

    .form-container {
      background: #ffffff;
      border-radius: 12px;
      padding: 2rem;
      max-width: 600px;
      margin: 2rem auto;
      box-shadow: 0 4px 15px rgba(0,0,0,0.05);
      border: 1px solid #f1e5dc;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    label {
      font-weight: 500;
      color: #5D2913;
    }

    input, select, textarea {
      padding: 10px;
      border: 1px solid #d7c9b8;
      border-radius: 8px;
      font-family: 'Poppins', sans-serif;
      font-size: 1rem;
      width: 100%;
      background: #fffaf3;
    }

    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: #b23a48;
      box-shadow: 0 0 4px rgba(178, 58, 72, 0.4);
    }

    button {
      background-color: #2d8b41ff;
      color: #FFFFD1;
      font-weight: 600;
      border: none;
      border-radius: 8px;
      padding: 0.8rem 1.5rem;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    button:hover {
      background-color: #43b35bff;
      transform: translateY(-2px);
    }

    .button-row {
      margin-top: 1.5rem;
      display: flex;
      justify-content: space-between;
      gap: 1rem;
    }

    .back-btn {

      display: inline-block;
      padding: 0.8rem 1.5rem;
      border-radius: 8px;
      font-weight: 550;
      text-decoration: none;
      transition: all 0.3s ease;
    }

    .delete-btn {
      display: inline-block;
      padding: 0.6rem 1.2rem;
      border-radius: 8px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.3s ease;
    }

    .back-btn {
      background-color: #6075d3ff;
      color: #ffffffff;
      border: 1px solid #e0c8b2;
    }

    .back-btn:hover {
      background-color: #8396e9ff;
      transform: translateY(-2px);
    }

    .delete-btn {
      background-color: #b23a48;
      color: #fff;
      border: none;
    }

    .delete-btn:hover {
      background-color: #a3303d;
      transform: translateY(-2px);
    }
  </style>

  <div class="form-container">
    <div class="header">
      <img src="{{ asset('images/Screenshot_2025-10-11_215348-removebg-preview.png') }}" alt="Mirano Logo" class="logo-img">
      <h1>Edit Menu</h1>
    </div>

    {{ include('mirano_menu/_form.html.twig', {'button_label': 'Update'}) }}

    <div class="button-row">
      <a href="{{ path('app_mirano_menu_index') }}" class="back-btn">Back to list</a>
      {{ include('mirano_menu/_delete_form.html.twig') }}
    </div>
  </div>
{% endblock %}
