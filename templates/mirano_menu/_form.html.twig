{# mirano_menu/_form.html.twig #}

{{ form_start(form) }}

<div class="space-y-6">
    <!-- Name -->
    <div>
        {{ form_label(form.name, 'Name', {
            'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}
        }) }}
        {{ form_widget(form.name, {
            'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-rose-500 focus:ring-rose-500 sm:text-sm'}
        }) }}
        {{ form_errors(form.name) }}
    </div>

    <!-- Category -->
    <div>
        {{ form_label(form.category, 'Category', {
            'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}
        }) }}
        {{ form_widget(form.category, {
            'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-rose-500 focus:ring-rose-500 sm:text-sm'}
        }) }}
        {{ form_errors(form.category) }}
    </div>

    <!-- Price -->
    <div>
        {{ form_label(form.price, 'Price', {
            'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}
        }) }}
        {{ form_widget(form.price, {
            'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-rose-500 focus:ring-rose-500 sm:text-sm'}
        }) }}
        {{ form_errors(form.price) }}
    </div>

    <!-- Description -->
    <div>
        {{ form_label(form.description, 'Description', {
            'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}
        }) }}
        {{ form_widget(form.description, {
            'attr': {
                'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-rose-500 focus:ring-rose-500 sm:text-sm',
                'placeholder': 'Write a short description of the dish...'
            }
        }) }}
        {{ form_errors(form.description) }}
    </div>
</div>

<div class="mt-6">
    <button class="bg-rose-600 text-black px-4 py-2 rounded-lg shadow hover:bg-rose-700">
        {{ button_label|default('Save') }}
    </button>
</div>

{{ form_end(form) }}
