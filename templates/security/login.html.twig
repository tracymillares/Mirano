{% extends 'base.html.twig' %}

{% block title %}Log in{% endblock %}

{% block body %}
<style>
    body {
        font-family: 'Poppins', sans-serif;
        background-color: #fff8f5;
    }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.4);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .modal {
        background: #fff;
        padding: 2rem;
        border-radius: 16px;
        width: 90%;
        max-width: 400px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        text-align: center;
        position: relative;
    }

    .modal h1 {
        color: #b23a48;
        margin-bottom: 1rem;
    }

    .form-control {
        width: 100%;
        padding: 0.6rem 0.8rem;
        margin-bottom: 1rem;
        border-radius: 8px;
        border: 1px solid #ccc;
        font-size: 0.95rem;
    }

    .btn {
        background-color: #b23a48;
        color: #fff8f5;
        border: none;
        padding: 0.8rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        width: 100%;
        transition: 0.2s;
    }

    .btn:hover {
        background-color: #7e3b1b;
        transform: translateY(-2px);
    }

    .alert {
        padding: 0.8rem;
        border-radius: 8px;
        margin-bottom: 1rem;
        font-size: 0.9rem;
    }

    .alert-success {
        background-color: #d4edda;
        color: #155724;
    }

    .alert-danger {
        background-color: #f8d7da;
        color: #721c24;
    }
</style>

<div class="modal-overlay">
    <div class="modal">

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message }}
            </div>
        {% endfor %}

        {% if error %}
            <div class="alert alert-danger">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <h1>Login</h1>

        <form method="post" style="display: flex; flex-direction: column;">
            <input type="text" value="{{ last_username }}" name="_username" placeholder="Username" class="form-control" autocomplete="username" required autofocus>
            <input type="password" name="_password" placeholder="Password" class="form-control" autocomplete="current-password" required>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button class="btn" type="submit">Sign in</button>
        </form>

        <p style="margin-top:1rem; font-size:0.9rem;">
            Don't have an account? <a href="{{ path('app_register') }}" style="color:#b23a48;">Register</a>
        </p>
    </div>
</div>
{% endblock %}
