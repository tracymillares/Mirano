{% extends 'base.html.twig' %}

{% block title %}Reservations{% endblock %}

{% block body %}

{% include 'layouts/sidebar.html.twig' %}


  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background-color: #fff8f5;
      color: #333;
      line-height: 1.7;
      margin: 0;
      padding: 0;
    }

    .logo-img {
      width: 70px;
      height: auto;
      margin-right: 10px;
      padding: 10px;
      transition: transform 0.3s ease;
    }


    .reservation-section {
      padding: 5rem 2rem;
      background-color: #fff8f5;
      min-height: 100vh;
      text-align: center;
    }

    .reservation-header {
      max-width: 700px;
      margin: auto;
      margin-bottom: 3rem;
    }

    .reservation-header h1 {
      font-family: 'Merriweather', serif;
      font-size: 2.8rem;
      color: #5D2913;
      margin-bottom: 1rem;
    }

    .reservation-header p {
      color: #6b4a3b;
      font-size: 1.1rem;
    }

    /* === GRID === */
    .reservation-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
      max-width: 1100px;
      margin: auto;
    }

    .reservation-card {
      background-color: #ffffff;
      border: 1px solid #f3e0d6;
      border-radius: 16px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.05);
      padding: 2rem;
      text-align: left;
      transition: all 0.3s ease;
    }

    .reservation-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 8px 20px rgba(0,0,0,0.1);
    }

    .reservation-card h2 {
      font-family: 'Merriweather', serif;
      font-size: 1.5rem;
      color: #5D2913;
      margin-bottom: 0.5rem;
    }

    .reservation-card p {
      color: #6b4a3b;
      font-size: 0.95rem;
      margin: 0.3rem 0;
    }

    .reservation-card strong {
      color: #5D2913;
    }

    /* === ACTIONS === */
    .reservation-actions {
      display: flex;
      justify-content: space-between;
      margin-top: 1.5rem;
    }

    .reservation-actions button,
    .reservation-actions a {
      background: none;
      border: none;
      font-weight: 600;
      font-size: 0.95rem;
      cursor: pointer;
      color: #5D2913;
      transition: color 0.3s ease;
      text-decoration: none;
    }

    .reservation-actions button:hover,
    .reservation-actions a:hover {
      color: #b23a48;
    }

    /* === ADD BUTTON === */
    .add-button {
      display: inline-block;
      margin-top: 3rem;
      background-color: #5D2913;
      color: #FFFFD1;
      padding: 0.9rem 2.2rem;
      border-radius: 10px;
      font-weight: 600;
      font-size: 1rem;
      transition: all 0.3s ease;
      box-shadow: 0 5px 12px rgba(0,0,0,0.1);
    }

    .add-button:hover {
      background-color: #7e3b1b;
      transform: translateY(-3px);
      box-shadow: 0 8px 18px rgba(0,0,0,0.15);
    }

    /* === MODAL === */
    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.45);
      backdrop-filter: blur(4px);
      justify-content: center;
      align-items: center;
      z-index: 999;
    }

    .modal-content {
      background: #fff;
      padding: 2rem 2.5rem;
      border-radius: 16px;
      width: 90%;
      max-width: 500px;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
      text-align: left;
      animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
      from {opacity: 0; transform: scale(0.95);}
      to {opacity: 1; transform: scale(1);}
    }

    .modal h2 {
      color: #5D2913;
      font-family: 'Merriweather', serif;
      margin-bottom: 1rem;
    }

    .modal p {
      color: #6b4a3b;
      margin-bottom: 0.5rem;
    }

    .close-btn, .delete-btn, .save-btn {
      border: none;
      padding: 0.7rem 1.4rem;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .close-btn {
      background: #5D2913;
      color: #FFFFD1;
    }

    .close-btn:hover {
      background: #7e3b1b;
    }

    .delete-btn {
      background: #b23a48;
      color: #fff;
    }

    .delete-btn:hover {
      background: #922b3e;
    }

    .save-btn {
      background: #2d8b41ff;;
      color: #FFFFD1;
    }

    .save-btn:hover {
      background: #43b35bff;
    }

    input, textarea {
      width: 100%;
      padding: 0.7rem;
      border-radius: 8px;
      border: 1px solid #ccc;
      margin-bottom: 0.8rem;
      font-size: 1rem;
      color: #333;
    }
  </style>

  <section class="reservation-section">
    <div class="reservation-header">
      <h1>Reservations</h1>
      <p>View and manage all table bookings.</p>
    </div>

    {% if reservations is empty %}
      <p class="no-records">No reservations yet.</p>
    {% else %}
      <div class="reservation-grid">
        {% for reservation in reservations %}
          <div class="reservation-card">
            <h2>{{ reservation.name }}</h2>
            <p><strong>Email:</strong> {{ reservation.email }}</p>
            <p><strong>Phone:</strong> {{ reservation.phone }}</p>
            <p><strong>Guests:</strong> {{ reservation.guest }}</p>
            <p><strong>Date:</strong> {{ reservation.date ? reservation.date|date('F j, Y g:i A') : 'N/A' }}</p>
            {% if reservation.message %}
              <p><strong>Message:</strong> {{ reservation.message }}</p>
            {% endif %}

            <div class="reservation-actions">
              <button class="view-btn"
                      data-id="{{ reservation.id }}"
                      data-name="{{ reservation.name }}"
                      data-email="{{ reservation.email }}"
                      data-phone="{{ reservation.phone }}"
                      data-guest="{{ reservation.guest }}"
                      data-date="{{ reservation.date ? reservation.date|date('F j, Y g:i A') : 'N/A' }}"
                      data-message="{{ reservation.message }}"
                      data-token="{{ csrf_token('delete' ~ reservation.id) }}">
                View
              </button>
              <button class="edit-btn"
                      data-id="{{ reservation.id }}"
                      data-name="{{ reservation.name }}"
                      data-email="{{ reservation.email }}"
                      data-phone="{{ reservation.phone }}"
                      data-guest="{{ reservation.guest }}"
                      data-message="{{ reservation.message }}">
                Edit
              </button>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    <a href="{{ path('app_reservation_new') }}" class="add-button">Create New Reservation</a>
  </section>

  <!-- 🌸 VIEW MODAL -->
  <div class="modal" id="viewModal">
    <div class="modal-content">
      <h2 id="viewName"></h2>
      <p><strong>Email:</strong> <span id="viewEmail"></span></p>
      <p><strong>Phone:</strong> <span id="viewPhone"></span></p>
      <p><strong>Guests:</strong> <span id="viewGuest"></span></p>
      <p><strong>Date:</strong> <span id="viewDate"></span></p>
      <p><strong>Message:</strong> <span id="viewMessage"></span></p>

      <form id="deleteForm" method="post" onsubmit="return confirm('Are you sure you want to delete this reservation?');" style="margin-top: 1rem;">
        <input type="hidden" name="_token" id="deleteToken" value="">
        <button type="submit" class="delete-btn">🗑️ Delete</button>
      </form>

      <div style="text-align: right; margin-top: 1.5rem;">
        <button class="close-btn" id="closeView">Close</button>
      </div>
    </div>
  </div>


  <!-- ✏️ EDIT MODAL -->
  <div class="modal" id="editModal">
    <div class="modal-content">
      <h2>Edit Reservation</h2>
      <form id="editForm" method="post">
        <input type="hidden" name="id" id="editId">

        <label for="editName"><strong>Name</strong></label>
        <input type="text" name="name" id="editName" placeholder="Enter guest name" required>

        <label for="editEmail"><strong>Email</strong></label>
        <input type="email" name="email" id="editEmail" placeholder="Enter email address" required>

        <label for="editPhone"><strong>Phone</strong></label>
        <input type="text" name="phone" id="editPhone" placeholder="Enter contact number" required>

        <label for="editGuest"><strong>Number of Guests</strong></label>
        <input type="number" name="guest" id="editGuest" placeholder="e.g. 2" required min="1">

        <label for="editDate"><strong>Date & Time</strong></label>
        <input type="datetime-local" name="date" id="editDate" required>

        <label for="editMessage"><strong>Message (Optional)</strong></label>
        <textarea name="message" id="editMessage" rows="3" placeholder="Add special requests or notes..."></textarea>

        <div style="display: flex; justify-content: flex-end; gap: 0.8rem; margin-top: 1rem;">
          <button type="button" class="close-btn" id="closeEdit">Cancel</button>
          <button type="submit" class="save-btn">Update</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const viewModal = document.getElementById('viewModal');
    const editModal = document.getElementById('editModal');
    const deleteForm = document.getElementById('deleteForm');
    const deleteToken = document.getElementById('deleteToken');

    document.querySelectorAll('.view-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.getElementById('viewName').textContent = btn.dataset.name;
        document.getElementById('viewEmail').textContent = btn.dataset.email;
        document.getElementById('viewPhone').textContent = btn.dataset.phone;
        document.getElementById('viewGuest').textContent = btn.dataset.guest;
        document.getElementById('viewDate').textContent = btn.dataset.date;
        document.getElementById('viewMessage').textContent = btn.dataset.message || '—';

        const id = btn.dataset.id;
        deleteForm.action = `/reservation/${id}`;
        deleteToken.value = btn.dataset.token;

        viewModal.style.display = 'flex';
      });
    });

    document.querySelectorAll('.edit-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.getElementById('editName').value = btn.dataset.name;
        document.getElementById('editEmail').value = btn.dataset.email;
        document.getElementById('editPhone').value = btn.dataset.phone;
        document.getElementById('editGuest').value = btn.dataset.guest;
        document.getElementById('editMessage').value = btn.dataset.message;
        document.getElementById('editForm').action = `/reservation/${btn.dataset.id}/edit`;

        editModal.style.display = 'flex';
      });
    });

    document.getElementById('closeView').addEventListener('click', () => viewModal.style.display = 'none');
    document.getElementById('closeEdit').addEventListener('click', () => editModal.style.display = 'none');

    window.addEventListener('click', e => {
      if (e.target === viewModal) viewModal.style.display = 'none';
      if (e.target === editModal) editModal.style.display = 'none';
    });
  </script>
{% endblock %}
